<launch>
  <arg name="gui" default="false"/>
  <!-- Reuse upstream components with a smaller numerical integration step. -->
  <include file="$(find ur_gazebo)/launch/inc/load_ur5e.launch.xml">
    <arg name="transmission_hw_interface" value="hardware_interface/EffortJointInterface"/>
  </include>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
  <rosparam file="$(find ur_gazebo)/config/ur5e_controllers.yaml" command="load"/>
  <!-- Initialization is deliberately sequenced by initialize_simulation.py:
       spawn while paused, set joints, load controllers, then start physics. -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="true"/>
    <arg name="world_name" value="$(dirname)/../worlds/control.world"/>
  </include>
</launch>
